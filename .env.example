# Copia este archivo a ".env" (ya está en .gitignore) y ajusta los valores.
# Nunca usar estos valores como secretos de producción.

ASPNETCORE_ENVIRONMENT=Development

# --- Usado por dotnet run local (fuera de Docker) ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=kindredpaws;Username=kindredpaws;Password=change-me

Minio__Endpoint=localhost:9000
Minio__AccessKey=change-me
Minio__SecretKey=change-me
Minio__BucketName=kindred-paws-media
Minio__UseSSL=false

RabbitMq__HostName=localhost
RabbitMq__UserName=guest
RabbitMq__Password=guest
RabbitMq__VirtualHost=/

Authentication__Google__ClientId=replace-with-google-client-id
Authentication__Google__ClientSecret=replace-with-google-client-secret

# Solo Development/Demo. Rotar inmediatamente y exigir cambio en primer acceso.
Seed__SuperAdmin__UserName=superadmin
Seed__SuperAdmin__Password=superadmin
Seed__SuperAdmin__Email=superadmin@kindredpaws.local

# --- Usado por docker-compose.yml (interpolación de ${VARIABLE}) ---
POSTGRES_USER=kindredpaws
POSTGRES_PASSWORD=kindredpaws-dev
POSTGRES_DB=kindredpaws

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

MINIO_ROOT_USER=kindredpaws
MINIO_ROOT_PASSWORD=kindredpaws-dev

JWT_KEY=development-only-change-this-key-32-chars

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
SUPERADMIN_EMAIL=superadmin@kindredpaws.local

{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=kindredpaws;Username=kindredpaws;Password=change-me"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Key": "development-only-change-this-key-32-chars",
    "Issuer": "kindred-paws-api",
    "ExpirationMinutes": 60
  },
  "Seed": {
    "SuperAdmin": {
      "UserName": "superadmin",
      "Password": "superadmin",
      "Email": "superadmin@kindredpaws.local"
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "NotificationQueue": "kindred-paws.notifications"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "change-me",
    "SecretKey": "change-me",
    "UseSSL": false,
    "BucketName": "kindred-paws-media"
  }
}

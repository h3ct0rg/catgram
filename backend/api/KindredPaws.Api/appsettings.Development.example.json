{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=kindredpaws;Username=kindredpaws;Password=change-me"
  },
  "Jwt": {
    "Key": "replace-with-a-development-key-of-at-least-32-chars"
  },
  "Authentication": {
    "Google": {
      "ClientId": "replace-with-google-client-id",
      "ClientSecret": "replace-with-google-client-secret"
    }
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "replace-with-minio-access-key",
    "SecretKey": "replace-with-minio-secret-key",
    "BucketName": "kindred-paws-media",
    "UseSSL": false,
    "UrlExpirationSeconds": 3600
  }
}
